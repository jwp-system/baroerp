# saas | single
DEPLOY_MODE=single

# 설치형 기본: SQLite / SaaS·데모: PostgreSQL
DATABASE_URL=sqlite:///./data/baroerp.db
# DATABASE_URL=postgresql+psycopg://baroerp:baroerp@localhost:5432/baroerp
DB_POOL_SIZE=5

SECRET_KEY=change-me
# 개인정보 암호화 키(Fernet). 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_KEY=
DEBUG=true
# 데모: 사업자번호는 10자리 숫자인지만 확인(검증번호 생략)
DEMO_MODE=false

# Cloud Run 데모에서는 false (Cloud Scheduler 사용)
SCHEDULER_ENABLED=true

# local | gcs (s3는 다음 단계)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/attachments
STORAGE_BUCKET=

# 내장 백업: 매일 03:00 자동(스케줄러), 최근 N개 보관. Cloud Storage 사용 시 버킷의 backups/
BACKUP_LOCAL_DIR=./data/backups
BACKUP_KEEP=7
# Cloud Scheduler가 POST /tasks/backup 호출 시 쓰는 토큰(Authorization: Bearer). 비우면 사용 안 함
TASK_TOKEN=

# 공공데이터포털 국세청 사업자등록 상태조회 서비스키(디코딩 키)
NTS_API_KEY=
